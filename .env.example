# Supabase project configuration
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Browser-exposed Supabase configuration (VITE_ values are public by design)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only application secrets
BUYERFRONT_ADMIN_KEY=replace-with-a-strong-random-secret
LOVABLE_API_KEY=replace-with-your-lovable-api-key
LOVABLE_CRON_SECRET=replace-with-a-strong-random-secret
LOVABLE_CRON_SECRET_PREVIOUS=replace-with-the-previous-secret-during-rotation
LOVABLE_SEND_URL=https://example.invalid/send
BUFFER_API_KEY=replace-with-your-buffer-api-key

# Server-only AI provider credentials
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
PERPLEXITY_API_KEY=replace-with-your-perplexity-api-key
